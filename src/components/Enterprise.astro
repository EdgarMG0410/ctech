---
import Icon from './Icon.astro';
import { site } from '../data/courses';

// Pasos de la capacitación empresarial. Edita textos o agrega/quita pasos aquí.
const steps = [
  { title: 'Diagnóstico', text: 'Entendemos qué necesita resolver tu equipo.', items: ['Sesión con dirección', 'Mapa de habilidades'] },
  { title: 'Programa a la medida', text: 'Contenido construido sobre tus casos.', items: ['Temario adaptado', 'Ejemplos de tu industria'] },
  { title: 'Implementación', text: 'Lo aprendido se aplica en tus proyectos.', items: ['Ejercicios en tus cuentas', 'Profesionales activos'] },
  { title: 'Seguimiento', text: 'Revisamos qué cambió en la operación.', items: ['Revisión de avances', 'Ajustes al plan'] },
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="enterprise" id="empresas" aria-labelledby="ent-t">
  <div class="wrap reveal">
    <div class="ent-head">
      <div>
        <div class="eyebrow">C Tech para empresas</div>
        <h2 id="ent-t">Tu equipo, en temporada de ejecución.</h2>
      </div>
      <p>Capacitación por etapas, aterrizada a la operación real de tu equipo de marketing y ventas.</p>
    </div>
    <ol class="ent-steps">
      {steps.map((s, i) => (
        <li class="ent-step" tabindex="0">
          <span class="ent-n" aria-hidden="true">{i + 1}</span>
          <small>PASO {pad(i + 1)}</small>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
        </li>
      ))}
    </ol>
    <div class="ent-foot">
      <span>Cada paso se adapta al tamaño y los objetivos de tu equipo.</span>
      <a class="btn btn-primary" href={`${site.base}/contacto`}>Solicitar propuesta <Icon name="arrow-right" /></a>
    </div>
  </div>
</section>
