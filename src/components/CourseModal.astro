---
/**
 * Ficha de curso compacta (sin scroll): arte a la izquierda, información a la derecha.
 * Las flechas ‹ › recorren los demás cursos sin cerrar la ficha.
 */
import type { Course } from '../data/courses';
import CourseArt from './CourseArt.astro';
import Icon from './Icon.astro';
interface Props { courses: Course[] }
const { courses } = Astro.props;
const n = courses.length;
---
<dialog id="course-modal" aria-label="Ficha del curso">
  <button class="m-close" aria-label="Cerrar"><Icon name="close" /></button>
  <div class="m-content" tabindex="-1" autofocus></div>
</dialog>

{courses.map((c, i) => {
  const prev = courses[(i - 1 + n) % n];
  const next = courses[(i + 1) % n];
  return (
    <template data-course={c.id}>
      <div class="m-wrap">
        <div class:list={['m-art', 'art', c.theme]}>
          <CourseArt theme={c.theme} variant="portrait" />
          <span class="art-badge"><span class="mod"></span>C TECH / {c.label.toUpperCase()}</span>
          <h3 set:html={c.tagline.replace('\n', '<br>')} />
        </div>
        <div class="m-info">
          <div class="meta">
            {c.free && <><span class="free">Gratis</span><i></i></>}
            <span>{c.specialty}</span>
          </div>
          <h2>{c.title}</h2>
          <p class="m-desc">{c.description}</p>
          <dl class="m-facts">
            <div><dt>Docente</dt><dd>{c.teacher}</dd></div>
            <div><dt>Nivel</dt><dd>{c.level}</dd></div>
          </dl>
          <div class="m-actions">
            <a class="btn btn-primary" href={c.url}>Ir al curso <Icon name="arrow-right" /></a>
            {n > 1 && (
              <div class="m-nav">
                <button class="m-step" data-open={prev.id} aria-label={`Curso anterior: ${prev.title}`}><Icon name="chevron-left" /></button>
                <span class="m-count">{i + 1} / {n}</span>
                <button class="m-step" data-open={next.id} aria-label={`Siguiente curso: ${next.title}`}><Icon name="chevron-right" /></button>
              </div>
            )}
          </div>
        </div>
      </div>
    </template>
  );
})}

<script>
  import '../scripts/modal';
</script>
