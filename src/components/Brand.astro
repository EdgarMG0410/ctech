---
interface Props { full?: boolean; href?: string; label?: string }
const { full = false, href = '#inicio', label = 'C Tech Consulting, inicio' } = Astro.props;
---
<a class="brand" href={href} aria-label={label}>
  <svg viewBox="0 0 554 756" aria-hidden="true"><use href="#iso" /></svg>
  {full
    ? <span><b>C Tech Consulting</b><small>Consultoría, capacitación e implementación</small></span>
    : <span><b>C Tech</b><small>Escuela de marketing</small></span>}
</a>
