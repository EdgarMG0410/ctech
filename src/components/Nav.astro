---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import NavPrograms from './NavPrograms.astro';
import { site } from '../data/courses';
interface Props { active?: string }
const { active = 'inicio' } = Astro.props;
const links = [
  { href: '/#inicio', label: 'Inicio' },
  { href: '/#programas', label: 'Programas' },
  { href: '/#ruta', label: 'Cómo aprendes' },
  { href: '/#empresas', label: 'Empresas' },
  { href: '/#preguntas', label: 'Preguntas' },
];
---
<header class="nav" id="nav">
  <div class="wrap nav-in">
    <Brand />
    <nav class="nav-links" aria-label="Principal">
      {links.map((l) => l.href === '/#programas' ? (
        <div class="nav-drop">
          <a href={l.href} class:list={['nav-link', { active: l.href === `/#${active}` }]} aria-expanded="false" aria-controls="nav-programas">{l.label}<Icon name="chevron-down" /></a>
          <div class="nav-panel" id="nav-programas" hidden>
            <p class="np-title">Programas educativos</p>
            <NavPrograms />
          </div>
        </div>
      ) : (
        <a href={l.href} class:list={['nav-link', { active: l.href === `/#${active}` }]}>{l.label}</a>
      ))}
    </nav>
    <div class="nav-end">
      <a class="login" href={`${site.base}/iniciar-sesion`}>Iniciar sesión</a>
      <a class="btn btn-primary btn-sm" href={`${site.base}/registro`}>Empieza gratis</a>
      <button class="menu-btn" aria-label="Abrir menú" aria-expanded="false" aria-controls="mnav"><Icon name="menu" /></button>
    </div>
  </div>
  <nav class="mnav" id="mnav" aria-label="Menú móvil" inert>
    {links.slice(1).map((l) => l.href === '/#programas' ? (
      <details class="mnav-drop">
        <summary>{l.label}<Icon name="chevron-down" /></summary>
        <NavPrograms />
      </details>
    ) : <a href={l.href}>{l.label}</a>)}
    <a href={`${site.base}/iniciar-sesion`}>Iniciar sesión</a>
  </nav>
</header>

<script>
  const nav = document.getElementById('nav')!;
  const onScroll = () => nav.classList.toggle('scrolled', scrollY > 24);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Menú móvil
  const btn = nav.querySelector<HTMLButtonElement>('.menu-btn')!;
  const mnav = document.getElementById('mnav')!;
  const setMenu = (open: boolean) => {
    mnav.classList.toggle('open', open);
    mnav.inert = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };
  btn.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
  mnav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // Desplegable de programas
  const dropWrap = nav.querySelector<HTMLElement>('.nav-drop')!;
  const drop = dropWrap.querySelector<HTMLAnchorElement>('.nav-link')!;
  const panel = document.getElementById('nav-programas')!;
  const setDrop = (open: boolean) => {
    panel.hidden = !open;
    drop.setAttribute('aria-expanded', String(open));
  };
  let closing = 0;
  dropWrap.addEventListener('pointerenter', (e) => {
    if (e.pointerType !== 'mouse') return;
    clearTimeout(closing);
    setDrop(true);
  });
  dropWrap.addEventListener('pointerleave', (e) => {
    if (e.pointerType === 'mouse') closing = window.setTimeout(() => setDrop(false), 200);
  });
  drop.addEventListener('click', (e) => {
    e.preventDefault();
    setDrop(panel.hidden);
  });
  panel.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setDrop(false);
  });
  document.addEventListener('click', (e) => {
    if (!dropWrap.contains(e.target as Node)) setDrop(false);
  });
  dropWrap.addEventListener('focusout', (e) => {
    const next = e.relatedTarget as Node | null;
    if (next && !dropWrap.contains(next)) setDrop(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || panel.hidden) return;
    setDrop(false);
    drop.focus();
  });

  // Subrayado amarillo en la sección activa
  const links = [...nav.querySelectorAll<HTMLAnchorElement>('.nav-link')];
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((l) => {
          const on = l.hash === '#' + e.target.id;
          l.classList.toggle('active', on);
          on ? l.setAttribute('aria-current', 'location') : l.removeAttribute('aria-current');
        });
      }),
    { rootMargin: '-45% 0px -50% 0px' }
  );
  links.forEach((l) => {
    const el = l.pathname === location.pathname ? document.querySelector(l.hash) : null;
    if (el) io.observe(el);
  });
</script>
